{
  "name": "vesti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "assets": "tsx scripts/assets.ts",
    "test:graph": "tsx tests/graph.integration.ts",
    "smoke:discovery": "tsx scripts/discovery-smoke.ts",
    "build:web": "tsx scripts/assets.ts && vite build --config apps/web/vite.config.ts",
    "start:api": "tsx apps/api/index.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.227.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "10.1.8",
    "@mediapipe/tasks-vision": "0.10.32",
    "dotenv": "^16.6.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "neo4j-driver": "^5.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
